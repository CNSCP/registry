# Part One — allocation and organizations
DATABASE_URL=postgres://registry:registry@localhost:5432/cp_registry
PORT=8081

# Loopback by default. This host carries the seam (§9.3), which authorizes
# writes; binding it to every interface should be deliberate, with a proxy in
# front of it.
BIND_HOST=127.0.0.1

# Bearer token Part Two presents to call the seam (§4.4: machine clients use
# bearer tokens exclusively). At least 32 characters; the server refuses to
# start without it. Generate with:  openssl rand -hex 32
INTERNAL_SEAM_TOKEN=

# Host this instance serves (§4.4). Part One lives on tlp.
PUBLIC_HOST=tlp.cnscp.io

# Audit chain anchor signing key (§4.3). Not used by the spine; reserved.
# ANCHOR_SIGNING_KEY=

# Part Three — resolution (cp.cnscp.io). Read-only; no credentials on this path.
RESOLUTION_PORT=8080
# RENDER_HTML=false   # a JSON-only instance is fully conforming (§19.1)
